@page "/"
@attribute [Authorize]
@implements IDisposable
@inject IObjectSpaceFactory objectSpaceFactory
@inject ISecurityProvider securityProvider

<div style="text-align: right; margin: 10px">
    <a class="ml-md-auto btn btn-primary" href="/logout">Log Out</a>
</div>

<CascadingValue Value="objectSpace">
    <DxGrid Data="employees" KeyFieldName="@nameof(Employee.ID)" PageSize="20" ShowFilterRow="true" AllowSort="true" @ref="grid"
            CustomizeEditModel="OnCustomizeEditModel" EditModelSaving="OnEditModelSaving">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(Employee.FirstName)">
                <CellDisplayTemplate Context="context">
                    <SecuredContainer Context="readOnly" CurrentObject="@context.DataItem" PropertyName="@nameof(Employee.FirstName)">
                        @(((Employee)context.DataItem)?.FirstName)
                    </SecuredContainer>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(Employee.LastName)">
                <CellDisplayTemplate Context="context">
                    <SecuredContainer Context="readOnly" CurrentObject="@context.DataItem" PropertyName="@nameof(Employee.LastName)">
                        @(((Employee)context.DataItem)?.LastName)
                    </SecuredContainer>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(Employee.Email)">
                <CellDisplayTemplate Context="context">
                    <SecuredContainer Context="readOnly" CurrentObject="@context.DataItem" PropertyName="@nameof(Employee.Email)">
                        @(((Employee)context.DataItem)?.Email)
                    </SecuredContainer>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(Employee.Department)">
                <EditSettings>
                    <DxComboBoxSettings Data="@departments"
                                        TextFieldName="@nameof(Department.Title)"
                                        ValueFieldName="@nameof(Employee.Department)">
                    </DxComboBoxSettings>
                </EditSettings>
                <CellDisplayTemplate Context="displayContext">
                    <SecuredContainer Context="readOnly" CurrentObject="@displayContext.DataItem" PropertyName="@nameof(Employee.Department)">
                        @(((Employee)displayContext.DataItem)?.Department?.Title)
                    </SecuredContainer>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridCommandColumn Width="100px">
                <HeaderTemplate Context="headerContext">
                    @if (Security.CanCreate<Employee>()) {
                        <DxButton Click="() => StartNewRow()"
                                  Enabled="headerContext.NewEnabled"
                                  Text="New" />
                    }
                </HeaderTemplate>
                <CellDisplayTemplate Context="cellContext">
                    @if (Security.CanWrite(cellContext.DataItem)) {
                        <a @onclick="@(() => StartRowEdit(cellContext.DataItem))" href="javascript:;">Edit </a>
                    }
                    @if (Security.CanDelete(cellContext.DataItem)) {
                        <a @onclick="@(() => OnRowRemoving(cellContext.DataItem))" href="javascript:;">Delete</a>
                    }
                </CellDisplayTemplate>
            </DxGridCommandColumn>
        </Columns>
        <EditFormTemplate Context="employeeContext">
            @{
                <EditForm Model=employee Context="EditFormContext">
                    <DxFormLayout>
                        <DxFormLayoutItem Caption="First Name">
                            <Template>
                                <SecuredContainer Context="readOnly" CurrentObject=@employee PropertyName=@nameof(Employee.FirstName) IsEditor=true>
                                    <DxTextBox @bind-Text=employee.FirstName ReadOnly=@readOnly />
                                </SecuredContainer>
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Last Name">
                            <Template>
                                <SecuredContainer Context="readOnly" CurrentObject=@employee PropertyName=@nameof(Employee.LastName) IsEditor=true>
                                    <DxTextBox @bind-Text=employee.LastName ReadOnly=@readOnly />
                                </SecuredContainer>
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Email">
                            <Template>
                                <SecuredContainer Context="readOnly" CurrentObject=@employee PropertyName=@nameof(Employee.Email) IsEditor=true>
                                    <DxTextBox @bind-Text=employee.Email ReadOnly=@readOnly />
                                </SecuredContainer>
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Department">
                            <Template>
                                <SecuredContainer Context="readOnly" CurrentObject=@employee PropertyName=@nameof(Employee.Department) IsEditor=true>
                                    <DxComboBox Data="@departments" ReadOnly=@readOnly @bind-Value=employee.Department />
                                </SecuredContainer>
                            </Template>
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </EditForm> 
            }
        </EditFormTemplate>
    </DxGrid>

</CascadingValue>

@code {
    IQueryable<Employee> employees;
    IQueryable<Department> departments;
    DxGrid grid;
    Employee employee = null;
    IObjectSpace objectSpace;
    SecurityStrategy Security => (SecurityStrategy)securityProvider.GetSecurity();

    protected override void OnInitialized() {
        objectSpace = objectSpaceFactory.CreateObjectSpace<Employee>();
        RefreshEmployees();
        departments = objectSpace.GetObjectsQuery<Department>();
        base.OnInitialized();
    }
    void OnCustomizeEditModel(GridCustomizeEditModelEventArgs e) {
        employee = new Employee() { ID = new Guid() };
        if (!e.IsNew) {
            CopyEmployee((Employee)e.DataItem, employee);
        }
        e.EditModel = employee;
    }
    void OnEditModelSaving(GridEditModelSavingEventArgs e) {
        Employee editModel = (Employee)e.EditModel;
        if (e.IsNew) {
            Employee currentObject = objectSpace.CreateObject<Employee>();
            CopyEmployee(editModel, currentObject);
        }
        else {
            CopyEmployee(editModel, (Employee)e.DataItem);
        }
        objectSpace.CommitChanges();
        RefreshEmployees();
    }

    void OnRowRemoving(object item) {
        objectSpace.Delete(item);
        objectSpace.CommitChanges();
        RefreshEmployees();
    }
    private void RefreshEmployees() {
        employees = objectSpace.GetObjectsQuery<Employee>().ToList().AsQueryable();
        StateHasChanged();
    }

    Task StartRowEdit(object item) {
        employee = (Employee)item;
        return grid.StartEditDataItemAsync(item);
    }
    Task StartNewRow() {
        return grid.StartEditNewRowAsync();
    }

    public void Dispose() {
        objectSpace?.Dispose();
    }
    private Employee CopyEmployee(Employee source, Employee target) {
        target.Birthday = source.Birthday;
        target.Department = source.Department;
        target.Email = source.Email;
        target.FirstName = source.FirstName;
        target.LastName = source.LastName;
        return target;
    }
}
